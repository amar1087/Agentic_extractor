# ── Database (docker compose up -d) ─────────────────────────────
DATABASE_URL="postgresql://agentuser:localpassword@localhost:5433/agentdb?schema=public"

# ── API server ─────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:5173          # where the UI is served (links in emails, OAuth redirect back)
JWT_SECRET=                            # openssl rand -hex 32
ENCRYPTION_KEY=                        # openssl rand -hex 32 — encrypts Gmail refresh tokens
STORAGE_DIR=storage                    # local stand-in for the S3 bucket

# ── Local LLM (NFR-02) ─────────────────────────────────────────
LLM_PROVIDER=ollama                    # ollama | openai (any OpenAI-compatible server, e.g. vLLM)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_VISION_MODEL=qwen2.5vl:7b          # for .png/.jpg invoices — ollama pull qwen2.5vl:7b
LLM_CONCURRENCY=1
# LLM_API_KEY=

# ── Gmail ingestion + sending (optional) ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/mailbox/oauth/google/callback
GMAIL_POLL_MINUTES=5

# ── SMTP fallback for reminders (optional) ─────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
REMINDER_INTERVAL_MINUTES=60

# ── Seed user (pnpm seed) ──────────────────────────────────────
SEED_ADMIN_EMAIL=admin@demo.test
SEED_ADMIN_PASSWORD=                   # pick one; never commit the real .env

# ── AWS (production path — not used by the local server yet) ──
# QUEUE_URL=
# QUEUE_DLQ_URL=
