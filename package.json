{
  "name": "agentic-extractor",
  "version": "1.0.0",
  "description": "Multi-agent invoice extraction, review and payment-reminder system",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "pnpm --dir web dev",
    "build": "tsc -p tsconfig.json && pnpm build:web",
    "build:web": "pnpm --dir web build",
    "start": "node dist/server/index.js",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:graph": "tsx src/test-graph.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/client-secrets-manager": "^3.1075.0",
    "@aws-sdk/client-ses": "^3.1075.0",
    "@aws-sdk/client-sqs": "^3.1075.0",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/langgraph-checkpoint": "^1.2.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/pdf-parse": "^1.1.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^182.0.0",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.11",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/multer": "^2.3.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
